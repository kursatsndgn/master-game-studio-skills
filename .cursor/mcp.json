{
  "mcpServers": {
    "blender-mcp": {
      "command": "python",
      "args": [
        "mcp-connectors/blender-mcp/blender_mcp_bridge.py",
        "--port",
        "9876"
      ],
      "env": {
        "BLENDER_PORT": "9876"
      }
    },
    "godot-mcp": {
      "command": "python",
      "args": [
        "mcp-connectors/godot-mcp/godot_mcp_bridge.py",
        "--port",
        "9080"
      ],
      "env": {
        "GODOT_WS_PORT": "9080"
      }
    },
    "unity-mcp": {
      "command": "uv",
      "args": [
        "--directory",
        "mcp-connectors/unity-mcp/upstream/Server",
        "run",
        "mcp-for-unity",
        "--transport",
        "stdio"
      ],
      "description": "MCP for Unity (CoplayDev/unity-mcp, submodule). Unity tarafı: Package Manager > Add from disk > mcp-connectors/unity-mcp/upstream/MCPForUnity"
    },
    "unreal-mcp": {
      "command": "python",
      "args": [
        "mcp-connectors/unreal-mcp/unreal_mcp_bridge.py",
        "--port",
        "30010"
      ],
      "env": {
        "UNREAL_RC_PORT": "30010"
      }
    },
    "qgis-mcp": {
      "command": "uv",
      "args": [
        "--directory",
        "mcp-connectors/qgis-mcp/upstream/src/qgis_mcp",
        "run",
        "qgis_mcp_server.py"
      ],
      "description": "QGIS MCP (jjsantos01/qgis_mcp, submodule). Eklenti: upstream/qgis_mcp_plugin -> QGIS profili python/plugins; varsayilan port 9876 (Blender ile ayni; ikisi birlikte aciksa eklentide degistir)"
    }
  }
}
